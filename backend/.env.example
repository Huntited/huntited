PORT=3001
# Origines du front autorisées, séparées par des virgules
# (ex. ajoute http://<IP-du-PC>:5173 pour tester depuis un téléphone).
CORS_ORIGIN=http://localhost:5173
# mock = aucun appel Matrix ; synapse = homeserver réel (pas encore implémenté)
MATRIX_MODE=mock
MATRIX_HOMESERVER_URL=https://matrix.huntited.org
# MATRIX_ACCESS_TOKEN est BACKEND-ONLY : ne jamais le mettre dans une variable VITE_.
MATRIX_ACCESS_TOKEN=
CHAT_DEFAULT_TTL_MS=86400000

# Secret de signature des jetons d'accès au chat (backend-only, long et aléatoire).
AUTH_JWT_SECRET=generate-a-long-random-development-secret
AUTH_TOKEN_TTL_SECONDS=900
# Session obtenue par une signature du wallet (une par visite).
AUTH_SESSION_TTL_SECONDS=3600

# Registre partagé des chasses (fichier JSON, hors git). Vide = mémoire seulement.
REGISTRY_FILE=data/registry.json

# Réseau Kaspa accepté pour les signatures (testnet uniquement pour l'instant).
KASPA_NETWORK=testnet-10
# signature = vraie vérification (wallet Kastle) ; mock = wallet factice du front
# (VITE_WALLET_MODE=mock), développement uniquement, interdit en production.
WALLET_AUTH_MODE=signature
