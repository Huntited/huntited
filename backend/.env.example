PORT=3001
# Origines du front autorisées, séparées par des virgules
# (ex. ajoute http://<IP-du-PC>:5173 pour tester depuis un téléphone).
CORS_ORIGIN=http://localhost:5173
# mock = aucun appel Matrix ; synapse = serveur Matrix réel (voir docs/matrix.md)
MATRIX_MODE=mock
MATRIX_HOMESERVER_URL=https://matrix.huntited.org
# MATRIX_ACCESS_TOKEN est BACKEND-ONLY : ne jamais le mettre dans une variable VITE_.
MATRIX_ACCESS_TOKEN=
# Mode synapse : nom du serveur (@x:<nom>) et application Element (https).
MATRIX_SERVER_NAME=
MATRIX_CLIENT_URL=
CHAT_DEFAULT_TTL_MS=86400000
# Salons ouverts (fichier JSON, hors git) : survivent à un redémarrage.
CHAT_FILE=data/chats.json

# Secret de signature des jetons d'accès au chat (backend-only, long et aléatoire).
AUTH_JWT_SECRET=generate-a-long-random-development-secret
AUTH_TOKEN_TTL_SECONDS=900
# Session obtenue par une signature du wallet (une par visite).
AUTH_SESSION_TTL_SECONDS=3600

# Registre partagé des chasses (fichier JSON, hors git). Vide = mémoire seulement.
REGISTRY_FILE=data/registry.json

# Réseau Kaspa accepté pour les signatures (testnet uniquement pour l'instant).
KASPA_NETWORK=testnet-10
# signature = vraie vérification (wallet Kastle) ; mock = wallet factice du front
# (VITE_WALLET_MODE=mock), développement uniquement, interdit en production.
WALLET_AUTH_MODE=signature

# Multiplie les limites de fréquence par IP (1 = normal ; à augmenter si
# beaucoup de personnes partagent la même connexion, ex. box ou réseau 4G).
RATE_LIMIT_MULTIPLIER=1

# Pass Huntited (anti-bots, voir docs/anti-bots.md).
# En réserve. Exigé pour s'engager ? (par défaut : non, tout le monde peut rejoindre)
PASS_REQUIRED=false
PASS_FILE=data/passes.json
# Invitations de départ, séparées par des virgules (24 caractères aléatoires min.).
PASS_GENESIS_INVITES=
PASS_INVITES_PER_MONTH=3

# Conseil « compte dédié » : lit l'historique public d'une adresse sur l'API
# du réseau de test (rien n'est conservé). Vide = désactivé.
KASPA_API_URL=https://api-tn10.kaspa.org

# Notifications « me prévenir » (Web Push, voir docs/notifications.md).
# Vides = désactivées. Générer : npx web-push generate-vapid-keys
# La clé PRIVÉE est backend-only.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_SUBJECT=mailto:Huntited@proton.me
PUSH_FILE=data/push.json
