// ============================================================================
// HuntCovenant.arg — Covenant de chasse Huntited (pseudo-code Argent/Silverscript)
// ----------------------------------------------------------------------------
// Un covenant de chasse bloque les dépôts des engagés et applique les règles
// de coordination de façon autonome : aucun tiers de confiance, aucun
// administrateur. Les règles ci-dessous sont exécutées on-chain.
//
// Principes :
//   - Privacy  : les engagements sont des commitments (empreintes), jamais
//                des identités. Le compteur réel est caché via ZK ; seule la
//                preuve "seuil atteint / non atteint" est publique.
//   - Atomique : l'action se déclenche pour tous ou pour personne.
//   - Sans maître : personne ne peut modifier les règles après création.
//
// NOTE : ce fichier est un pseudo-code de spécification. Les helpers
// verify_zk_* et merkle_insert sont mockés en attendant l'implémentation
// réelle des circuits ZK et de l'arbre de Merkle on-chain.
// ============================================================================

// ---------------------------------------------------------------------------
// Constantes du protocole (en sompis, 1 KAS = 10^8 sompis)
// ---------------------------------------------------------------------------
const MIN_CAUTION_SOMPI    = 30 * 10^8;   // caution minimale (le créateur peut mettre plus)
const COMMIT_DEPOSIT_SOMPI = 5 * 10^8;    // dépôt d'engagement
const MIN_THRESHOLD = 7;                   // actions vraiment collectives
// Le dépôt d'engagement est toujours rendu. En cas de succès seulement, le
// créateur finance une récompense prise sur sa caution C (rien à gagner en
// engageant des bots sur une chasse vouée à l'échec). Tout est proportionnel
// à C, et le créateur ne gagne jamais rien (on lui rend au plus C).
const SUCCESS_PARTICIPANTS_PERMILLE = 475; // 47,5 % de C au plus aux engagés
const SUCCESS_TREASURY_PERMILLE = 25;      // 2,5 % de C
const CAP_AND_FAILURE_DIVISOR = 30;        // plafond par engagé et frais d'échec : C / 30
const TREASURY_ADDRESS = treasury_multisig_hash;

// ---------------------------------------------------------------------------
// États du covenant
// ---------------------------------------------------------------------------
enum State {
  Active,      // chasse ouverte, engagements acceptés
  Activated,   // seuil atteint : action déclenchée, dépôts restituables
  Expired      // date limite passée sans atteindre le seuil
}

// ---------------------------------------------------------------------------
// Données portées par le covenant (état on-chain)
// ---------------------------------------------------------------------------
struct HuntCovenant {
  state: State;

  // Paramètres fixés à la création (immuables ensuite)
  deadline: timestamp;        // date limite d'engagement
  threshold: u64;             // seuil de participants
  creator: pubkey_hash;       // créateur (reçoit la redistribution éventuelle)
  caution: amount;            // caution déposée (≥ MIN_CAUTION_SOMPI)

  // Engagements : arbre de Merkle de commitments anonymes.
  // La taille réelle de l'arbre n'est JAMAIS publiée en clair :
  // elle n'est révélée que via une preuve ZK (seuil atteint ou non).
  commitments_root: hash;     // racine Merkle des commitments
  commit_count_hidden: u64;   // compteur interne, non exposé publiquement

  // Fonds bloqués dans le covenant
  balance: amount;            // somme des dépôts bloqués

  // Fixé à la résolution : part de la récompense versée à chaque engagé.
  reward_share_per_commit: amount;
}

// Résolution commune : treasury et créateur payés tout de suite ; chaque
// engagé réclame ensuite son dépôt + sa part (claim_deposit_and_reward).
// Parts arrondies au sompi inférieur ; le reste (ou toute part sans
// destinataire) revient au créateur.
fn settle(covenant: HuntCovenant, participants_pool: amount, treasury: amount) {
  let n = covenant.commit_count_hidden;
  let even = if (n == 0) { 0 } else { participants_pool / n };
  covenant.reward_share_per_commit = min(even, covenant.caution / CAP_AND_FAILURE_DIVISOR);
  send(TREASURY_ADDRESS, treasury);
  send(covenant.creator, covenant.caution - treasury
    - n * covenant.reward_share_per_commit);
  covenant.balance = n * (COMMIT_DEPOSIT_SOMPI + covenant.reward_share_per_commit);
}

// ---------------------------------------------------------------------------
// Helpers mockés — à remplacer par les vraies primitives ZK / Merkle
// ----------------------------------------------------------------------------

// Vérifie une preuve ZK "je connais un secret dont le commitment est dans
// l'arbre" SANS révéler lequel. MOCK : accepte toute preuve non vide.
fn verify_zk_membership(proof: bytes, root: hash) -> bool {
  // MOCK — remplacer par la vérification du circuit ZK réel
  return proof.length > 0 && root != 0;
}

// Vérifie une preuve ZK "le compteur caché est >= threshold" SANS révéler
// le compteur. MOCK : compare le compteur interne directement.
fn verify_zk_threshold_reached(covenant: HuntCovenant, proof: bytes) -> bool {
  // MOCK — remplacer par la vérification du circuit ZK réel
  require(proof.length > 0, "preuve ZK requise");
  return covenant.commit_count_hidden >= covenant.threshold;
}

// Insère un commitment dans l'arbre de Merkle et renvoie la nouvelle racine.
// MOCK : empreinte de l'ancienne racine concaténée au commitment.
fn merkle_insert(root: hash, commitment: hash) -> hash {
  // MOCK — remplacer par un vrai insert Merkle (ou arbre append-only)
  return sha256(root || commitment);
}

// ---------------------------------------------------------------------------
// Entrées du covenant
// ---------------------------------------------------------------------------

// create_hunt : crée le covenant et bloque le dépôt de création.
// Le créateur fixe deadline et threshold ; ils sont immuables ensuite.
fn create_hunt(deadline: timestamp, threshold: u64) -> HuntCovenant {
  require(deadline > now(), "la date limite doit être dans le futur");
  require(threshold >= MIN_THRESHOLD, "le seuil doit être d'au moins 7 personnes");
  require(tx.value >= MIN_CAUTION_SOMPI, "caution d'au moins 30 KAS requise");

  return HuntCovenant {
    state: State.Active,
    deadline: deadline,
    threshold: threshold,
    creator: tx.sender,
    caution: tx.value,
    commitments_root: 0,
    commit_count_hidden: 0,
    balance: tx.value,
    reward_share_per_commit: 0
  };
}

// commit : un participant s'engage. Il dépose 5 KAS et soumet un commitment
// anonyme (SHA-256(huntId | secret)) accompagné d'une preuve ZK de validité.
// Aucune identité n'est liée au commitment : privacy-first.
fn commit(covenant: HuntCovenant, commitment: hash, zk_proof: bytes) {
  require(covenant.state == State.Active, "la chasse n'est pas ouverte");
  require(now() < covenant.deadline, "la date limite est passée");
  require(tx.value >= COMMIT_DEPOSIT_SOMPI, "dépôt d'engagement de 5 KAS requis");
  require(commitment != 0, "commitment invalide");
  require(verify_zk_membership(zk_proof, covenant.commitments_root)
          || covenant.commit_count_hidden == 0,
          "preuve ZK invalide");

  covenant.commitments_root = merkle_insert(covenant.commitments_root, commitment);
  covenant.commit_count_hidden += 1;   // compteur interne, jamais publié en clair
  covenant.balance += tx.value;
}

// activate : déclenche l'action collective quand le seuil est atteint.
// N'importe qui peut appeler cette entrée avec une preuve ZK valide :
// la preuve atteste "seuil atteint" SANS révéler le nombre d'engagés.
fn activate(covenant: HuntCovenant, zk_proof: bytes) {
  require(covenant.state == State.Active, "chasse déjà close");
  require(now() < covenant.deadline, "la date limite est passée");
  require(verify_zk_threshold_reached(covenant, zk_proof),
          "seuil non atteint (preuve ZK invalide)");

  covenant.state = State.Activated;
}

// distribute_deposit_on_success : récompense plafonnée à 1 KAS par engagé (succès).
fn distribute_deposit_on_success(covenant: HuntCovenant) {
  require(covenant.state == State.Activated, "la chasse n'est pas activée");
  settle(covenant,
    covenant.caution * SUCCESS_PARTICIPANTS_PERMILLE / 1000,
    covenant.caution * SUCCESS_TREASURY_PERMILLE / 1000);
}

// expire : clôture la chasse si la date limite est passée sans activation.
// N'importe qui peut l'appeler ; aucune récompense, dépôts rendus.
fn expire(covenant: HuntCovenant) {
  require(covenant.state == State.Active, "chasse déjà close");
  require(now() >= covenant.deadline, "la date limite n'est pas passée");
  settle(covenant, 0, covenant.caution / CAP_AND_FAILURE_DIVISOR);
  covenant.state = State.Expired;
}

// claim_deposit_and_reward : après la résolution (succès ou échec), chaque
// engagé réclame son dépôt + sa part de la récompense avec une preuve ZK de
// membership. Adresse de sortie fournie dans la transaction, jamais liée au
// commitment.
fn claim_deposit_and_reward(covenant: HuntCovenant, zk_proof: bytes) {
  require(covenant.state == State.Activated || covenant.state == State.Expired,
          "la chasse n'est pas résolue");
  require(verify_zk_membership(zk_proof, covenant.commitments_root),
          "preuve d'engagement invalide");
  let payout = COMMIT_DEPOSIT_SOMPI + covenant.reward_share_per_commit;
  send(tx.recipient, payout);
  covenant.balance -= payout;
}

// ---------------------------------------------------------------------------
// Garde temporelle globale : une chasse Active dont la deadline est passée
// ne peut plus recevoir d'engagement ni être activée — seulement expirée.
// Cette règle est appliquée par le covenant lui-même, pas par un serveur.
// ---------------------------------------------------------------------------
