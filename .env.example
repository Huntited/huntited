# Variables du site (version statique : npm run build:static les fixe déjà).
# local = chasses de démonstration dans ce navigateur ; chain = registre sur
# la blockchain (réseau de test), comme le site en ligne.
VITE_DATA_MODE=local
# mock = wallet factice ; kastle = wallet intégré, ou Kastle s'il est installé
VITE_WALLET_MODE=mock
